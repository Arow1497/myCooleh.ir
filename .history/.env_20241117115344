# Server Configuration
NODE_ENV=deveopment
BASE_URL=http://localhost
APPLICATION_PORT=7000
API_VERSION=v1
CORS_ORIGIN=*
TRUST_PROXY=1

# Database Configuration
DATABASE_URL="mysql://arrow1497:09210128550Mhf@localhost:3306/cooleh_project"
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_MODE=require
DATABASE_TIMEOUT=30000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=3600
REDIS_PREFIX=cooleh:
REDIS_CLUSTER_MODE=false

# Security
JWT_SECRET=your_strong_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your_strong_session_secret
CSRF_SECRET=your_strong_csrf_secret
COOKIE_SECRET=your_strong_cookie_secret
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# Payment Gateway
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_REQUEST_URL=https://api.zarinpal.com/pg/v4/payment/request.json
ZARINPAL_VERIFY_URL=https://api.zarinpal.com/pg/v4/payment/verify.json
ZARINPAL_GATEWAY_URL=https://www.zarinpal.com/pg/StartPay
PAYMENT_CALLBACK_URL=your_callback_url

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,mp4
FFMPEG_PATH=/usr/local/bin/ffmpeg

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_DIR=./logs
MORGAN_FORMAT=combined
WINSTON_MAX_SIZE=20m
WINSTON_MAX_FILES=14d

# Monitoring
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_newrelic_license
DATADOG_API_KEY=your_datadog_api_key

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@yourdomain.com

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# Queue Configuration
BULL_REDIS_URL=redis://localhost:6379
BULL_PREFIX=cooleh:bull:
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF=5000

# Socket.IO
SOCKET_PATH=/socket.io
SOCKET_ORIGINS=*:*
SOCKET_PING_TIMEOUT=5000
SOCKET_PING_INTERVAL=10000

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
SWAGGER_VERSION=1.0.0

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=your_strong_initial_password

# Kafka Configuration
KAFKA_CLIENT_ID=cooleh-service
KAFKA_BROKER_LIST=localhost:9092
KAFKA_GROUP_ID=cooleh-group