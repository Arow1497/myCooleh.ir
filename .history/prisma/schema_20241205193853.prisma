//................... Post model - forum posts Bussines-side......................//
model Post {
  id          String       @id @default(uuid())
  title       String
  description String
  content     String    @db.Text
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  postField   PostFields
  postType    PostType

 // Media - Changed to one-to-many relation
  featuredImage   String?
  contentMedia    ContentMedia[]      @relation("PostMedia")

 // repost related
  isRepost            Boolean     @default(false)
  originalPostId      String?     // آیدی پست اصلی در صورت ریپست بودن
  originalPost        Post?       @relation("Reposts", fields: [originalPostId], references: [id])
  reposts             Post[]      @relation("Reposts")
  repostCount         Int         @default(0)

  postReposts         Repost[]    @relation("PostReposts")

  // Author
  authorId    String
  author      SocialProfile      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  // Categories and tags
  categories  CategoryOnPost[]
  tags        TagOnPost[]

  // Stringeractions
  comments    Comment[] 
  likes       Like[]     @relation("PostLikes")
  dislikes    Dislike[]  @relation("PostDislikes")
  bookmarks   Bookmark[] @relation("PostBookmarks")
  shares      Share[]    @relation("PostShares")

  // Meta
  viewCount   Int       @default(0)
  shareCount  Int       @default(0)
  slug        String    @unique
