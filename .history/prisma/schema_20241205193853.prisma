model ClanCommunicationThread {
//   ClanCommunicationThread یک مدل کاملاً جدید است که من پیشنهاد کردم. این مدل جدید، یک سطح انتزاعی و سازماندهی‌شده‌تر برای مکالمات و موضوعات گروهی در کلن ارائه می‌دهد.
// تفاوت اصلی با مدل ClanCommunication:
// ClanCommunication (مدل اصلی):

// یک پست/پیام منفرد
// محدود به یک تماس کوتاه
// داری reactions و replies ساده

// ClanCommunicationThread (مدل پیشنهادی):

// یک موضوع/گفتگوی کامل
// شامل چندین پیام مرتبط
// دارای وضعیت (باز، بسته، در حال پیگیری)
// قابلیت دسته‌بندی و تگ‌گذاری
// ردیابی کامل‌تر فعالیت
// مثال:
// ClanCommunication: یک پیام درباره فروش قطعه
// ClanCommunicationThread: تمام مذاکرات مرتبط با آن فروش از ابتدا تا انتها
  id                   String    @id @default(uuid())
  clanId               String    @unique
  clan                 Clan      @relation(fields: [clanId], references: [id])
  title                String
  category             CommunicationCategory
  status               CommunicationThreadStatus
  messages             Message[]
  pinnedMessages       String  // آی‌دی پیام‌های مهم

  // ردیابی وضعیت گفتگو
  lastActivityAt       DateTime
  initiatorId          String
  participants      CommunicationThreadParticipant[]
  
  // متادیتا و تگ‌گذاری
  tags                 String
  metadata             Json?
}

