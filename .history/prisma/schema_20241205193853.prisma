datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}


// Core User Model - اطلاعات اصلی و ضروری کاربر
model User {
  id               String         @id @default(uuid())
  mobile           String         @db.VarChar(11)
  otp_code         Int           @default(0)
  otp_expires      Int           @default(0)
  password         Int?
  passwordResetAt  DateTime      @default(now())
  registrationDate DateTime      @default(now())
  isSystemAdmin    Boolean       @default(false)
  isActive         Boolean       @default(true)
  isSuspended      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  courseRegistration  CourseRegistration?
  products         Product[]
  basket           Basket[]  
  userRole         UserRole[]
  adInteraction    AdInteraction?
  adApproval       AdApproval?
// Clan relations
  ownedClan         Clan?     @relation("clanOwner")
  joinRequests      ClanJoinRequest[]
  memberships       ClanMembership[]
  sentInvites       ClanInvite[]     @relation("sentInvites")
  receivedInvites   ClanInvite[]     @relation("receivedInvites")
  activities        ClanActivity[]
  reactions         ClanCommunicationReaction[]
  replies           ClanCommunicationReply[]
  
// Business & Reputation
  reputation        Float     @default(0)
  totalTransactions Int       @default(0)
  successRate       Float     @default(0)
  approvedUserMapping  ApprovedUserMapping?

// Supplier-specific metrics
  supplierRating    Float?
  responseTime      Float?    // Average response time in hours
  qualityScore      Float?
  

  // Business Features
  subscriptions         Subscription[]
  customer              Customer[]
  subscriptionStatus    SubscriptionStatus
  status                UserStatus @default(ACTIVE)
  notifications         Notification[]  @relation("UserNotifications")
  notificationSettings UserNotificationSettings?
  communicationThreadParticipant  CommunicationThreadParticipant?

  // Related Profiles
  businessProfile            BusinessProfile?
  projectProfile             ProjectProfile?
  socialProfile              SocialProfile?
  activityProfile            ActivityProfile?
  interactiveContentProfile  InteractiveContentProfile?
  userProfile                UserProfile?
  
  clanCouponBookmark   ClanCouponBookmark[]
  clanCouponLike       ClanCouponLike[]
  clanCouponComment    ClanCouponComment[]

  @@unique([mobile])
}

model UserProfile {
  id                    String       @id @default(uuid())
  userId                String       @unique
  user                  User      @relation(fields: [userId], references: [id])
  
  // Personal Information
  first_name            String?   @db.VarChar(50)
  last_name             String?   @db.VarChar(50)
  nationalIdNumber      String?   @db.VarChar(10)
  bankAccountNumber     String?   @db.VarChar(16)
  
  // Location Information
  province              String?   @db.VarChar(20)
  city                  String?   @db.VarChar(20)
  location              String?
  garageLat_Lng         String?
  supplierStoreLat_Lng  String?
  
  // Business Metrics
  mechanicProjectsCount   String?
  apprenticeProjectsCount String?
  mechanicApprenticeCity  String?
  maxReachableReviewPoint  Int         @default(0)
  reviewPoint              Int         @default(0)
  
  // Media
  media                 UserMedia[]
  contentMedia          ContentMedia[]      @relation("UserMedia")
  profileImageUrl       String?             // Quick access to main profile image
  coverImageUrl         String?             // Quick access to cover image
  
  // Contact & Social
  website               String?
  socialLinks           Json?               // Store social media links/ zlink landingPage/story link UGC marketing

  // Timestamps
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([nationalIdNumber, bankAccountNumber])
}

// Business Profile - اطلاعات مرتبط با کسب و کار
model BusinessProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id])
  mechanicPercentage   String?
  apprenticePercentage String?
  bussinesRole         BusinessRole  @default(GARAGE_APPRENTICE)
  expertices           Expertices    @default(ENGINEGEARBOX)
  
  // Business Relations
  ownedSupplierStore  SupplierStore[]  @relation("supplierStoreOwner")
  ownedGarage         Garage[]          @relation("garageOwner")
  mechanicGarageId    String?     
  apprenticeGarageId  String?
  mechanicAt          Garage?  @relation("mechanics", fields: [mechanicGarageId], references: [id], map: "mechanics")
  apprenticeAt        Garage?  @relation("apprentices", fields: [apprenticeGarageId], references: [id], map: "apprentices")

   // Referral System
  referralCount        Int                 @default(0)
  referralAchievements ReferralAchievement[]
  referrerreferral     Referral[]   @relation("ReferrerProfile")
  referredreferral     Referral[]   @relation("ReferredProfile")
  referralStats        ReferralStats[]
  reward               Reward[]
  referralCodes        ReferralCode[]
  profit               Int                @default(0)
  league               UserLeague

// Moderation & Reports
  reportsFiled         Report[]     @relation("ReportFiler")
  reportedBy           Report[]     @relation("ReportedUser")

}

// Project Profile - اطلاعات مرتبط با پروژه‌ها
model ProjectProfile {
  id                            String    @id @default(uuid())
  userId                        String    @unique
  user                          User      @relation(fields: [userId], references: [id])
  
  inProgressProjectMechanic     ProjectsMechanicWorkAt[]
  inProgressProjectApprentice   ProjectsApprenticeWorkAt[]
  projectProvider               Project?   @relation("providerUser")

  advertisement                  Advertisement[]

  publishedmetrics              Metric[]

  // Complaints
  complaintsFiled               Complaint[]    @relation("ComplaintFiler")
  complaintsReceived            Complaint[]    @relation("ComplaintReceiver")

  // Coupons
  publishedCoupons                       Coupons[]  @relation("couponPublisher")
  acceptedCoupons                        CouponMechanicAcceptor[]
  successCoupons                         CouponMechanicSuccess[]
  Mechanic_GarageReqsForCouponAssignment Mechanic_GarageReqsForCouponAssignment?
  successfulSellCouponByGarage_Mechanic  SuccessfulSellCouponByGarage_Mechanic?
  clanCouponMechanicSuccess              ClanCouponMechanicSuccess[]
  clanCouponMechanicAcceptor             ClanCouponMechanicAcceptor[]

// Apprenticeship & Dastyar notices
  apprenticeNoticesPublisher         NoticeApprenticeship[] @relation("noticeApprenticePublisher")
  apprenticeNoticesApprentice        NoticeApprenticeship[] @relation("noticeApprenticeApprentice")
  garageOwnerReqsForApprentice       GarageReqsForApprenticeCoWork?      @relation("garageOwner")
  garageApprenticeBelongToGarageForApprentice GarageReqsForApprenticeCoWork?  @relation("apprentice")
  shagerdReqsForApprentice           ShagerdReqsForApprenticeCoWork?
  dastyarNoticesPublisher            NoticeDastyar[]        @relation("noticeDastyarPublisher")
  dastyarNoticesMechanic             NoticeDastyar[]        @relation("noticeDastyarMechanic")
  mechanicReadyToWork                MechanicReadyToWork?
  garageOwnerReqsForMechanic             GarageReqsForDastyarCoWork?           @relation("garageOwner")
  garageMechanicBelongToGarageForDastyar GarageReqsForDastyarCoWork?         @relation("mechanic")
  mechanicReqsForDastyar                 MechanicReqsForDastyarCoWork?
  garagePartOrder                        GaragePartOrder[] 
  sellFromSupplier                       SellFromSupplier[]
  supplierStoreReqsForMetricAssignment   SupplierStoreReqsForMetricAssignment? @relation("metricReqPublisher")
  
  
}

// Social Profile - اطلاعات اجتماعی و تعاملات
model SocialProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  socialLinks           Json?
  
  // Social Interactions
  posts                 Post[]    @relation("UserPosts")
  reposts               Repost[]                    @relation("UserReposts")
  originalPosts         Repost[]                    @relation("OriginalPoster")
  comments              Comment[] @relation("UserComments")
  likes                 Like[]    @relation("UserLikes")
  dislikes              Dislike[]  @relation("UserDislikes")
  shares                Share[]   @relation("UserShares")
  bookmarks             Bookmark[] @relation("UserBookmarks")
  reviews               Review[]       @relation("ReviewAuthor")
  receivedReviews       Review[]       @relation("ReviewTarget")
  
  // Social Features
  conversations ConversationParticipant[]
  reactions     MessageReaction[]
  readReceipts  MessageReadReceipt[]

  noticeDivar                        NoticeDivar[]  @relation("UserDivarN")
  noticeEstNiaz                      NoticeEstNiaz[]  @relation("UserEstN")
  noticePartProviding                NoticePartProviding[]  @relation("UserPartPN")
  noticeShopSupplier                 NoticeShopSupplier[]   @relation("UserShopSupplierN")
  garageReqForOutSource              GarageReqsForOutSourcingCoWork?
  garageRequirementsRequest          GarageRequirementsRequest[]          @relation("UserGarageRequirementMediaN")
  autoServicesRequirementsRequest    AutoServicesRequirementsRequest[]    @relation("UserAutoServicesRequirementMediaN")
  commentvote                        CommentVote[]               @relation("UserCommentsVote")
  commentReport                      CommentReport[]
  noticeOutSourcing                  NoticeOutSourcing[]    
}

// Activity Profile - فعالیت‌ها و لاگ‌ها
model ActivityProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  lastLoginAt     DateTime?
  lastActiveAt    DateTime?
  
  // Activity Tracking
  sessions        Session[]
  activities      UserActivity[]
  tokenRecords    TokenRecord[]
  permissionAuditLog PermissionAuditLog[]
}

// Interactive Content Profile - محتوا و نوتیفیکیشن‌ها
model InteractiveContentProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  
  // Content Items
 
}

//....... Client model - Bussineses Clients(Public-side)........//
model Client {
  id                String        @id @default(uuid())
  first_name        String?    @db.VarChar(50)
  last_name         String?    @db.VarChar(50)
  mobile            String     @unique
  otp_code          Int        @default(0)
  otp_expires       Int        @default(0)
  carPlateNumber    String?    @db.VarChar(8)
  carModel          String?
  carChassisNumber  String?
  carBuildYear      String?
  carMillage        String?
  province          String?
  city              String?
  role              BusinessRole  @default(CLIENT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // RBAC
  roles            ClientRole[]
  isPrivileged     Boolean    @default(false)  // For special client privileges
  permissionAuditLog PermissionAuditLog[]

  metricCommunicationThreadParticipant    MetricCommunicationThreadParticipant?
  // Review
  reviews           Review[]
  product           Product[]
  //Metrics 
  metrics           Metric[]

  wasSupplierStoreMetricAssignmentSuccessful  WasSupplierStoreMetricAssignmentSuccessful?
 
  // Project Relations
  project           Project[]

  // Project Relations
  oilServiceProject GarageOilServiceProjects[]

  // Garage Await List
  garageAwaitList   GarageAwaitList[]

  // Garage PartOrder Collaboration
  garagePartOrder   GaragePartOrder[] 

  // Basket Selling System
  Basket              Basket[] 

  @@index([first_name, last_name, mobile], name: "client_search_index")
}

//....... Clan model - represents Networking(Bussines-side) data & information........//
model Clan {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  logoUrl     String?
  isSuspended      Boolean       @default(false) //در صورت عمل نکردن به تعهدات کوپن کل کلن بن میشن
  clanMAinType  ClanMainType @default(MECHANICHI)
  level       Int       @default(1)
  maxMembers  Int       @default(50)
  isPrivate   Boolean   @default(false)
  
// Ranking & Stats
  rankingScore Float    @default(0)
  weeklyScore  Float    @default(0)
  monthlyScore Float    @default(0)
  rank         Int?     // Global rank
  seasonRank   Int?     // Season rank
  
// Business Metrics
  totalTransactions    Int     @default(0)
  successfulDeals      Int     @default(0)
  reputationScore     Float    @default(0)
  activeSuppliers     Int      @default(0)
  activeGarages       Int      @default(0)
  
  // ClanCommercePartOrderTrading
  clanCommercePartOrderTrading  ClanCommercePartOrderTrading[]  
  
  clanCommunicationThread      ClanCommunicationThread?  

// Relations
  ownerId        String    @unique
  owner          User      @relation("clanOwner", fields: [ownerId], references: [id])
  members        ClanMembership[]
  joinRequests   ClanJoinRequest[]
  invites        ClanInvite[]
  metrics        ClanMetric[]
  coupons        ClanCoupon[]
  activities     ClanActivity[]
  rewards        ClanReward[]
  communications ClanCommunication[]
  rankings       ClanRanking[]
  
    // اضافه کردن فیلدهای مرتبط با گفتگو
  conversations        ClanConversation[]
  defaultConversation  String?           // گفتگوی پیش‌فرض کلن
    // تنظیمات گفتگو
  // chatSettings         Json? {
  //   allowedMessageTypes  MessageType[]
  //   maxAttachmentSize   Int
  //   messageRetentionDays Int
  // }
  
  
// Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

}

enum ClanMainType {
MECHANICHI
AUTOSERVICES
BODYSHOPS
}

model ClanMembership {
  id        String    @id @default(uuid())
  clanId    String
  userId    String
  role      ClanRole
  joinedAt  DateTime  @default(now())
  
// Activity Metrics
  contributionScore   Float    @default(0)
  transactionCount    Int      @default(0)
  reputationPoints    Float    @default(0)
  activityPoints      Int      @default(0)
  lastActiveAt        DateTime @default(now())

  clanNoticeOutSourcingPublisher  ClanDastyarOutSourcingApprenticeCollaburation?  @relation("clanNoticeOutSourcingPublisher")
  clanNoticeOutSourcingAcceptor   ClanDastyarOutSourcingApprenticeCollaburation?  @relation("clanNoticeOutSourcingAcceptor")
  garageReqsForClanOutSourcingCoWork   ReqsForClanOutSourcingDastyarApprenticeCoWork?  @relation("ReqsForClanOutSourcingCoWorkPublisher")

  
  clanCommercePartOrderTrading  ClanCommercePartOrderTrading?

   // دسترسی‌های گفتگو
  canCreateChannels    Boolean @default(false)
  canPinMessages      Boolean @default(false)
  canEditThreads      Boolean @default(false)
  communicationRoles  CommunicationRole

// Supplier-specific fields
  supplierTier        SupplierTier?
  dealSuccessRate     Float?
  responseRate        Float?
  qualityRating       Float?
  
// Relations
  clan               Clan      @relation(fields: [clanId], references: [id])
  user               User      @relation(fields: [userId], references: [id])
  metricCollaborations ClanMetricCollaborator[]
  earnedRewards      ClanReward[]
  communications     ClanCommunication[]
  
  @@unique([clanId, userId])
}

enum CommunicationRole {
  CHAT_ADMIN
  MODERATOR
  REGULAR_MEMBER
  RESTRICTED
}

// ClanCommercePartOrderTrading - Main trading model
model ClanCommercePartOrderTrading {
  id                     String      @id @default(uuid())
  clanId                 String
  clan                   Clan        @relation(fields: [clanId], references: [id])
  clanDealRepresentativeId String    @unique
  clanDealRepresentative ClanMembership @relation(fields: [clanDealRepresentativeId], references: [id])
  suplierStoreId         String?    
  acceptorSuppleirStore  SupplierStore?   @relation(fields: [suplierStoreId], references: [id])
  title                  String
  description           String?     
  isAvailable            Boolean        @default(true)
  city                   String
  requirements           Json?          
  attachments            Attachment[] 
  
  // Trading specific fields
  totalQuantity         Int        @default(0)  
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  tradingStatus        TradingStatus @default(OPEN)
  
  // Part list created by representative
  partsList            ClanCommercePartsList[]
  
  // Relations
  garageOrders         ClanCommerceGarageOrder[]
  conversation         Conversation[]
  reqForSupply         ClanCommercePartOrderTradingRequestedForSupply[]
  milestones           Milestone[]
  reviews              Review[]
  transactionsActivityLogs TransactionsActivityLog[]
  bookmarks            Bookmark[]
  share                Share[]

  // Deal status tracking
  dealStatus            CollaborationStatus  @default(PENDING)
  dealStartedAt         DateTime?
  dealEndedAt           DateTime?
  dealRating            Float?
  dealFeedback          String?
  
  // Timestamps
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  claimedAt             DateTime?
  expiresAt             DateTime?
}

model ClanCommercePartOrderTradingRequestedForSupply {
  id                  String      @id @default(uuid())
  supplierStoreId     String        
  supplierStore       SupplierStore  @relation(fields: [supplierStoreId], references: [id])
  attachment          Attachment[]
  status              supplierPartOrderReqStatus @default(PENDING)
  clanCommercePartOrderTradingId         String      @unique
  clanCommercePartOrderTrading           ClanCommercePartOrderTrading @relation(fields: [clanCommercePartOrderTradingId], references: [id])
  
  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  acceptedAt        DateTime?
  expiresAt         DateTime?    // تایمی تعیین میکنیم اگر بعد از اون تایم ایجاد نشه حذف شه
}

// ClanCommercePartsList - Parts list created by representative
model ClanCommercePartsList {
  id                     String      @id @default(uuid())
  tradingId              String
  trading               ClanCommercePartOrderTrading @relation(fields: [tradingId], references: [id])
  
  // Part details
  partName              String
  partNumber            String?
  brand                 String?
  condition             PartCondition @default(NEW)
  description           String?
  
  // Garage orders for this part
  garageQuantities      ClanCommerceGaragePartQuantity[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// ClanCommerceGarageOrder - Individual garage orders within trading
model ClanCommerceGarageOrder {
  id                     String      @id @default(uuid())
  clanCommercePartOrderTradingId String
  clanCommercePartOrderTrading ClanCommercePartOrderTrading @relation(fields: [clanCommercePartOrderTradingId], references: [id])
  garageId              String     
  garage                Garage     @relation(fields: [garageId], references: [id])
  
  // Order details
  status               OrderStatus @default(PENDING)
  
  // Additional fields
  notes                String?
  deliveryAddress      String?
  contactPerson        String?
  contactPhone         String?
  
  // Part quantities
  partQuantities       ClanCommerceGaragePartQuantity[]
  
  // Timestamps
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// ClanCommerceGaragePartQuantity - Quantities requested by each garage for each part
model ClanCommerceGaragePartQuantity {
  id                  String    @id @default(uuid())
  garageOrderId       String
  garageOrder         ClanCommerceGarageOrder @relation(fields: [garageOrderId], references: [id])
  partsListId         String
  partsList           ClanCommercePartsList @relation(fields: [partsListId], references: [id])
  
  quantity            Int
  notes               String?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([garageOrderId, partsListId])
}

// Required enums
enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  REJECTED
}

enum TradingStatus {
  OPEN
  SUPPLIER_SELECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
  AFTERMARKET
}

model ClanRanking {
  id            String    @id @default(uuid())
  clanId        String
  season        Int
  weekNumber    Int
  rank          Int
  score         Float
  
// Metrics that affected ranking
  transactionVolume  Float
  memberActivity     Float
  supplierRating     Float
  
// Relations
  clan          Clan      @relation(fields: [clanId], references: [id])
  
// Timestamps
  calculatedAt  DateTime  @default(now())
  
  @@unique([clanId, season, weekNumber])
}

model ClanDastyarOutSourcingApprenticeCollaburation {
  id              String      @id @default(uuid())
  publisherId     String      @unique
  publisher       ClanMembership     @relation("clanNoticeOutSourcingPublisher",fields: [publisherId], references: [id])
  title           String
  type            ClanCollaborationType
  status          CollaborationStatus  @default(PENDING)
  isAvailable     Boolean        @default(true)
  budget          Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  requirements    Json?          // Detailed project requirements
  // Toye in agahi ha attachment chizi hast ke garage 
  // darkhast dahande be agahi ezafe mikone hala chizayi ke badan garage pazirande 
  // ham bekhad be proje attach kone toye conversation va message handle mishe

  // Project relation (if attachment belongs to project)
  projectId            String        @unique
  project              Project       @relation(fields: [projectId], references: [id])
  
  // OutSourcing Notice Acceptor garage relation
  acceptorId      String       @unique
  acceptor        ClanMembership   @relation("clanNoticeOutSourcingAcceptor",fields: [acceptorId], references: [id])
  

  // Related records
  garageReqForProject  ReqsForClanOutSourcingDastyarApprenticeCoWork?
  reviews              Review[]

  // other fields...

}

enum ClanCollaborationType {
DASTYAR
APPRENTICE
OUTSOURCING
}

//........................ GarageReqsForOutSourcingCoWork model ..............................//
model ReqsForClanOutSourcingDastyarApprenticeCoWork {
  id              String      @id @default(uuid())
  publisherId     String      @unique
  publisher       ClanMembership     @relation("ReqsForClanOutSourcingCoWorkPublisher", fields: [publisherId], references: [id])
  requesterSuggestedPrice  Float
  clanNoticeOutSourcingId  String @unique
  clanNoticeOutSourcing    ClanDastyarOutSourcingApprenticeCollaburation   @relation(fields: [clanNoticeOutSourcingId], references: [id])

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ClanReward {
  id            String      @id @default(uuid())
  clanId        String
  memberId      String
  type          RewardType
  amount        Float
  description   String
  claimed       Boolean     @default(false)
  
// Relations
  clan          Clan            @relation(fields: [clanId], references: [id])
  member        ClanMembership  @relation(fields: [memberId], references: [id])
  
// Timestamps
  createdAt     DateTime    @default(now())
  claimedAt     DateTime?
  expiresAt     DateTime?
}

model ClanConversation {
  id                   String         @id @default(cuid())
  clanId               String         // ارتباط با کلن
  clan                 Clan           @relation(fields: [clanId], references: [id])
  
  // تمام فیلدهای Conversation
  type                 ConversationType @default(GROUP)
  name                 String?        // نام گفتگوی کلن
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastMessageAt        DateTime       @default(now())
  
  // اضافه کردن فیلدهای مختص کلن
  pinnedMessages       PinnedClanMessage[]
  
  // ارتباطات
  participants         ConversationParticipant[]
  messages             Message[]
}

model PinnedClanMessage {
  id                   String         @id @default(cuid())
  conversationId       String
  conversation         ClanConversation @relation(fields: [conversationId], references: [id])
  messageId            String      @unique
  message              Message        @relation(fields: [messageId], references: [id])
  pinnedBy             String         // کاربری که پیام را پین کرده
  pinnedAt             DateTime       @default(now())
}

 model ClanCommunication { // 
 //بیشتر شبیه به تابلوی اعلانات یا پست‌های گروهی است
 // تابلوی اعلانات کوپن ها و همکاری ها
// برای ارسال اطلاعیه‌ها، پیشنهادات و به اشتراک‌گذاری موضوعات کلی
// شامل عناصری مثل عکس‌العمل (Reaction) و پاسخ (Reply)
// محدود به نوع خاصی از ارتباط مانند معاملات، به‌روزرسانی‌ها و غیره
  id            String    @id @default(uuid())
  clanId        String
  senderId      String
  type          ClanCommunicationType
  title         String
  content       String
  metadata      Json?     // For type-specific data
  
// For supplier updates/offers
  dealValue     Float?
  validUntil    DateTime?
  
// Relations
  clan          Clan            @relation(fields: [clanId], references: [id])
  sender        ClanMembership  @relation(fields: [senderId], references: [id])
  reactions     ClanCommunicationReaction[]
  replies       ClanCommunicationReply[]
  
// Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ClanCommunicationReply {
  id              String    @id @default(uuid())
  communicationId String
  userId          String
  content         String
  
// Relations
