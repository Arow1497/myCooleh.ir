//............................. **Metric model ..............................//
model Metric {
  id              String      @id @default(uuid())
  publisherId     String
  publisher       ProjectProfile     @relation(fields: [publisherId], references: [id])
  garageId        String
  garage          Garage   @relation(fields: [garageId], references: [id])
