  post                      Post      @relation("PostMedia", fields: [postId], references: [id], onDelete: Cascade)
  productId                 String
  product                   Product   @relation("ProductMedia", fields: [productId], references: [id], onDelete: Cascade)
  noticeDivarId             String
  noticeDivar               NoticeDivar        @relation("DivarNMedia", fields: [noticeDivarId], references: [id], onDelete: Cascade)
  noticeEstId               String
  noticeEst                 NoticeEstNiaz        @relation("EstNMedia", fields: [noticeEstId], references: [id], onDelete: Cascade)  
  noticePartPId             String
  noticePartP               NoticePartProviding        @relation("PartPNMedia", fields: [noticePartPId], references: [id], onDelete: Cascade)  
  noticeShopSupplierId      String
  noticeShopSupplier        NoticeShopSupplier        @relation("ShopSupplierNMedia", fields: [noticeShopSupplierId], references: [id], onDelete: Cascade)  
  garageRequirementsRequestId        String
  garageRequirementsRequest          GarageRequirementsRequest        @relation("GarageRequirementMedia", fields: [garageRequirementsRequestId], references: [id], onDelete: Cascade)  
