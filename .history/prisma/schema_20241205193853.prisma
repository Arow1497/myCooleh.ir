  originalPoster    SocialProfile      @relation("OriginalPoster", fields: [originalPosterId], references: [id])
  
  // متن اضافی که کاربر موقع ریپست می‌تواند اضافه کند
  additionalContent String?   @db.Text
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([originalPosterId])
}

