  client          Client   @relation(fields: [clientId], references: [id])
  supplierStoreId String
  supplierStore   SupplierStore  @relation(fields: [supplierStoreId], references: [id])
  // ارتباط با پروژه مرتبط
  projectId     String?      @unique
  project       Project?     @relation(fields: [projectId], references: [id])
  metricType    MetricType
  city            String
  isAvailable          Boolean        @default(true)
  title           String
  description     String
  attanchment     Attachment[]
  status          CollaborationStatus  @default(PENDING)
  requirements    Json?          // Detailed project requirements
  carModel          String?
  carBuildYear      String?


   // Part details
  partSpecifications   PartSpecification[]
  quantity             String
  condition            PartCondition     @default(NEW)
  urgencyLevel         Int               @default(1) // 1-5 scale
  notes                String
  metricStatus         MetricPartStatus  // وضعیت فعلی
  
  currentUsage  Float         // میزان استفاده یا عمر فعلی
  maxLifespan   Float         // حداکثر عمر مورد انتظار
  
  estimatedReplacementCost Float? // هزینه تخمینی تعویض
  
  inspectionDate DateTime    @default(now())
  nextInspectionDate DateTime?
  
  recommendedAction String? // توصیه‌های تعمیراتی
  
  // درصد سود برای مکانیک
  mechanicCommissionPercentage Float? @default(0)

 // Conversation
  conversation    Conversation[]

  viewCount       Int       @default(0)
  shareCount      Int       @default(0)

  // Stringeractions
  comments        Comment[] 
  likes           Like[]     @relation("MetricLikes")
  dislikes        Dislike[]  @relation("MetricDislikes")
  bookmarks       Bookmark[] @relation("MetricBookmarks")
  shares          Share[]   @relation("MetricShares")
  
  supplierStoreReqsForMetricAssignment   SupplierStoreReqsForMetricAssignment? 
  wasSupplierStoreMetricAssignmentSuccessful  WasSupplierStoreMetricAssignmentSuccessful?
  MetricClientSupplierCommunicationThread     MetricClientSupplierCommunicationThread[]
  // Related records
  transaction     Transaction?
  milestones      Milestone[]
  reviews         Review[]
  transactionsActivityLogs    TransactionsActivityLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
}

