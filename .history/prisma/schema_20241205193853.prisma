// New model for tracking daily garage activities
model GarageActivityLog {
  id          String   @id @default(uuid())
  garageId    String
  garage      Garage   @relation(fields: [garageId], references: [id])
  date        DateTime @default(now())
  
  // Activity Types and Counts
  projectCount           Int     @default(0)  // New projects created
  collaborationCount     Int     @default(0)  // Collaborations with other garages
  partOrderCount         Int     @default(0)  // Part orders made
  completedProjectCount  Int     @default(0)  // Projects completed
  apprenticeshipCount    Int     @default(0)  // Apprenticeship activities
  outSourceCount         Int     @default(0)  // Outsourcing activities
  
  // Activity Level (similar to GitHub's contribution levels)
  activityLevel    ActivityLevel @default(NONE)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([garageId, date])
  @@index([date, activityLevel])
}

// Add this enum for activity levels
enum ActivityLevel {
  NONE      // No activity (gray)
  LOW       // Low activity (light green)
  MEDIUM    // Medium activity (medium green)
  HIGH      // High activity (darker green)
  VERY_HIGH // Very high activity (darkest green)
}

