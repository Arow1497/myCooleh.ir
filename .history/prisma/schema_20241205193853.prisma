}

// Part specification model to store different types of parts
model PartSpecification {
  id             String           @id @default(uuid())
  name           String        // e.g., "Brake Caliper", "Brake Pad"
  quantity       Int
  collaboratorPersentage    Float @default(0.1) // درصد حق همکاری (مثلا 10%)
  condition      PartCondition     @default(NEW)
  category       PartCategory
  brand          String?       // Brand name if specified
  model          String?       // Model compatibility
  year           String?         // Year of compatibility
  details        Json?        // Additional specifications as JSON
  supplyPartId   String?
  supplyPart     SupplyParts?   @relation(fields: [supplyPartId], references: [id])
  partOrderId    String?
  partOrder      PartOrder?     @relation(fields: [partOrderId], references: [id])

// Supplier Store Reuest For Metric
  supplierReqForMetricId  String
  supplierReqForMetric  SupplierStoreReqsForMetricAssignment @relation(fields: [supplierReqForMetricId], references: [id])
  
  // Coupons 
  couponId             String
  coupon               Coupons          @relation(fields: [couponId], references: [id])

// Metrics 
  metricId             String
  metric               Metric          @relation(fields: [metricId], references: [id])

// successfulSellCouponByGarage_Mechanic 
  successfulSellCouponByGarage_MechanicId             String
  successfulSellCouponByGarage_Mechanic    SuccessfulSellCouponByGarage_Mechanic  @relation(fields: [successfulSellCouponByGarage_MechanicId], references: [id])

// WasSupplierStoreMetricAssignmentSuccessful 
  wasSupplierStoreMetricAssignmentSuccessfulId             String
  wasSupplierStoreMetricAssignmentSuccessful   WasSupplierStoreMetricAssignmentSuccessful  @relation(fields: [wasSupplierStoreMetricAssignmentSuccessfulId], references: [id])

}

