// RBAC Models
model Role {
  id              String       @id @default(uuid())
  name            String    @unique
  description     String?
  permissions     Permission[]
  resources       RoleResource[] // یک نقش به چندین RoleResource دسترسی دارد
  rolePermissions RolePermission[]
  users           UserRole[]
  clients         ClientRole[]  // New relation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Permission {
  id              String       @id @default(uuid())
  name            String    @unique
  description     String?
  rolePermissions RolePermission[]
  roles           Role[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UserRole {
  id        String      @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// New model for Client roles
model ClientRole {
  id        String      @id @default(uuid())
  clientId  String
  roleId    String
  client    Client   @relation(fields: [clientId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, roleId])
}

// Audit trail for permission changes
model PermissionAuditLog {
  id            String      @id @default(uuid())
  userId        String
  user          ActivityProfile     @relation(fields: [userId], references: [id])
  clientId      String?     // Added clientId for client permission changes
  client        Client?  @relation(fields: [clientId], references: [id])
  action        String   // e.g., "GRANT_ROLE", "REVOKE_ROLE", "MODIFY_PERMISSIONS"
  resourceType  ResourceType?
  resourceId    String?
  oldValue      Json?    // Store previous state
  newValue      Json?    // Store new state
  createdAt     DateTime @default(now())
  createdBy     String      // ID of the user who made the change
  
  @@index([userId, createdAt])
}

model RoleResource {
  id             String          @id @default(uuid())
  roleId         String
  resourceId     String
  resourceType  ResourceType    // Enum برای نوع منبع (مثلاً پروژه، گاراژ)
  permission    ResourcePermission  // Enum برای نوع دسترسی (CREATE, READ, ...)
  role           Role            @relation(fields: [roleId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  @@unique([roleId, resourceId, resourceType, permission]) // جلوگیری از تخصیص تکراری
}

model RolePermission {
  id            String       @id @default(uuid())
  roleId        String
  permissionId  String
  role          Role         @relation(fields: [roleId], references: [id])
  permission    Permission   @relation(fields: [permissionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@unique([roleId, permissionId]) // جلوگیری از تخصیص تکراری مجوز به یک نقش
}
//////////////
// اگر نیاز به دسترسی‌های ساده و عمومی دارید، RolePermission کافی است.
// اگر نیاز دارید که دسترسی‌ها را به سطح منابع
//  خاص (مانند گاراژ، پروژه و ...) محدود کنید، از RoleResource استفاده کنید.
// مثال:
// مدیر گاراژ دارای مجوز عمومی نقش 
// "MANAGE" 
// در تمام گاراژها است 
// (از طریق RolePermission).
// نقش مکانیک تنها مجوز 
// "UPDATE" 
// در گاراژ شماره ۱۲۳ دارد 
// (از طریق RoleResource).
// Resource-specific permissions enums
////////////
enum ResourcePermission {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

