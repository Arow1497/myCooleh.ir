  // افزایش ریلیشن ها باعث کاهش کارامدی دیبی میشه٫٫ وقتی میخوای 
  // مثلا لیست اگهی های شاگرد یک گاراژ رو دراری کویری میزنی تمام پروژه هاش 
  // اونایی که فیلد اگهی شاگرد دارند همه اگهی ها رو نمایش میدی

  mechanicReqsForDastyarCoWork  MechanicReqsForDastyarCoWork?
  garageReqsForDastyarCoWork  GarageReqsForDastyarCoWork?

  projectsMechanicWorkAt      ProjectsMechanicWorkAt?
  projectsApprenticeWorkAt    ProjectsApprenticeWorkAt?

  // Conversation
  conversation         Conversation[]

  // Related records
  milestones           Milestone[]
  reviews              Review[]
  transactionsActivityLogs         TransactionsActivityLog[]
  bookmarks            Bookmark[]
  share                Share[]
}

