  suplierStoreId       String      @unique
  acceptedSuppleirStore SupplierStore   @relation(fields: [suplierStoreId], references: [id])
  partSupplyStatus     PartSupplyStatus   @default(NOTADD)
  mechanicsTeam        ProjectsMechanicWorkAt[]             
  apprenticesTeam      ProjectsApprenticeWorkAt[]           
  invoiceFactorUrl     String?
  title                String
  car                  String
  plateNumber          String   
  chassisNumber        String
  carMillage           String    
  buildYear            String    
  brokeReportDetails   String        
  fixReportDetails     String      
  clientRate           String  
  suppliedParts        String     
  invoiceFactor        String   
  partSupplyFactor     String
  description          String
  status               CollaborationStatus  @default(PENDING)
  budget               Float
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?
  priority             Priority       @default(NORMAL)
  deadline             DateTime?
  requirements         Json?          // Detailed project requirements
  attachments          Attachment[]      // Array of attachment URLs
   
  // SocialMedia Sharing Project-Resume Timeline FollowUp
  projectSMAttachments  ProjectSMAttachments[]   // Array of SMattachment URLs
  
  clanNoticeOutSourcing  ClanDastyarOutSourcingApprenticeCollaburation?
  // Conversation
  conversation         Conversation[]

  metric             Metric?
  // Garage Part Order
  garagePartOrder    GaragePartOrder[]

  // OutSourcing Notice 
  noticeOutSourcing  NoticeOutSourcing?

  // ApprenticeShip Notice 
  NoticeApprenticeship  NoticeApprenticeship?

 // Dastyar Notice 
  NoticeDastyar       NoticeDastyar?

  // Related records
  transaction          Transaction?
  milestones           Milestone[]
  reviews              Review[]
  transactionsActivityLogs         TransactionsActivityLog[]
}

//........................ GarageAwaitList model ..............................//
model GarageAwaitList {
  id                   String      @id @default(uuid())
