//........................ Notifications model ..............................//
model Notification {
  id            String    @id @default(cuid())
  user          User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          NotificationType
  title         String
  message       String
  link          String?   // Optional link to relevant content
  isRead        Boolean   @default(false)
  metadata      Json?     // Additional notification data
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  priority      NotificationPriority @default(NORMAL)
  status        NotificationStatus   @default(PENDING)
  expiresAt     DateTime? // مشخص کردن زمان انقضای نوتیفیکیشن (در صورتی که بعد از مدتی نمایش آن دیگر ضروری نباشد)
  deviceId      String? // اگر نوتیفیکیشن‌ها به دستگاه خاصی ارسال می‌شوند، این فیلد می‌تواند کاربردی باشد
  category      CategoryOnNotification? 
  deliveredAt   DateTime?
   tags         TagOnNotification?
  source        String? // مشخص کردن سیستمی که نوتیفیکیشن را تولید کرده است  
  retries       Int @default(0)  // برای نگهداری تعداد دفعاتی که برای ارسال این نوتیفیکیشن تلاش شده است

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([priority])
  @@index([status])
}

