  registrations CourseRegistration[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// مدل ثبت نام در دوره
model CourseRegistration {
  id            String    @id @default(cuid())
  
  user          User      @relation(fields: [userId], references: [id])
  userId        String    @unique
  
  course        Course    @relation(fields: [courseId], references: [id])
  courseId      String
  
  status        RegistrationStatus @default(PENDING)
  
  registeredAt  DateTime  @default(now())
  
  @@unique([userId, courseId]) // هر کاربر فقط یکبار می‌تواند در یک دوره ثبت نام کند
}

// وضعیت ثبت نام
enum RegistrationStatus {
  PENDING   // در انتظار تایید
  CONFIRMED // تایید شده
  CANCELLED // لغو شده
}

//.................. Customer model - represents payment/billing information..............//
model Customer {
  id               String       @id @default(uuid())

  // FreeLancer Relation
  userId            String       @unique
  user              User      @relation(fields: [userId], references: [id])
  
  // SupplierStore Relation
  supplierStoreId   String            @unique
  supplierStore     SupplierStore  @relation(fields: [supplierStoreId], references: [id])

  // Garage Relation
  garageId          String       @unique
  garage            Garage    @relation(fields: [garageId], references: [id])

  // Billing information
  billingMobile     String?
  billingName       String?
  billingAddress    Json?     // Stored as JSON for flexibility
  
  // Payment methods and history
  paymentMethods    Payment[]
  invoices          Invoice[]
}

//.................. Subscription model - tracks active and historical subscriptions...............//
model Subscription {
  id          String       @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  plan            Plan      @relation(fields: [planId], references: [id])
  planId          String
  
  // Subscription status
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  canceledAt      DateTime?
  
  // Billing cycle
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  
  billingRecords      BillingRecord[]
  subscriptionChanges SubscriptionChange[]
  usageLogs          UsageLog[]
  tierId             String
  currentTier        SubscriptionTier    @relation(fields: [tierId], references: [id])
  
  // Usage tracking
  usage           Usage[]
  
  // Track referral rewards
  referralRewards     SubscriptionReward[]
  totalRewardMonths   Int                   @default(0)

  // Metadata
  metadata        Json?     // Flexible field for additional data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Enhanced Subscription Tracking
model SubscriptionTier {
  id              String           @id @default(uuid())
  name            String
  description     String?
  features        Json          // Detailed feature set
  referralRequirements Json     // Requirements for referral-based upgrades
  plans           Plan[]        // Different payment plans for this tier
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscription    Subscription[]
}

// Track Feature Usage Limits
model FeatureLimit {
  id              String           @id @default(uuid())
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  featureKey      String        // Identifier for the feature
  monthlyLimit    String           // Monthly usage limit
  overage_price   Float?        // Price per unit over limit
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([planId, featureKey])
}

// Enhanced Usage Tracking
model UsageLog {
  id              String           @id @default(uuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  featureKey      String
  quantity        String
  timestamp       DateTime      @default(now())
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  
  @@index([subscriptionId, featureKey, billingPeriodStart, billingPeriodEnd])
}

// Billing History
model BillingRecord {
  id              String           @id @default(uuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  amount          Float
  billingDate     DateTime
  nextBillingDate DateTime
  status          BillingStatus
  paymentMethod   Payment @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId       String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Subscription Changes History
model SubscriptionChange {
  id              String           @id @default(uuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  fromPlanId      String?
  toPlanId        String
  fromPlan        Plan?         @relation("FromPlan", fields: [fromPlanId], references: [id])
  toPlan          Plan          @relation("ToPlan", fields: [toPlanId], references: [id])
  changeType      ChangeType
  reason          String?
  effectiveDate   DateTime
  createdAt       DateTime      @default(now())
}

//............. Plan model - defines different subscription tiers ...............//
model Plan {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  interval    BillingStringerval
  tier        PlanTier  // نوع پلن
  
  featureLimits     FeatureLimit[]
  fromChanges       SubscriptionChange[] @relation("FromPlan")
  toChanges         SubscriptionChange[] @relation("ToPlan")
  subscriptionTier  SubscriptionTier    @relation(fields: [tierId], references: [id])
  tierId            String
  
  // محدودیت‌های هر پلن
  maxMechanics    String     // حداکثر تعداد مکانیک
  maxApprentices  String     // حداکثر تعداد شاگرد
  
  // ویژگی‌های اضافی هر پلن
  features    Json      // ذخیره ویژگی‌ها به صورت JSON array
  
  // Plan status
  isActive    Boolean   @default(true)
  
  // Related subscriptions
  subscriptions Subscription[]
  
  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum BillingStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum ChangeType {
  UPGRADE
  DOWNGRADE
  REFERRAL_REWARD
  CANCELLATION
  REACTIVATION
}

// تعریف محدودیت‌های هر پلن
enum PlanTier {
  BASIC       // پلن پایه
  STANDARD    // پلن استاندارد
  PRO         // پلن حرفه‌ای
  ENTERPRISE  // پلن فوق‌العاده
}

//............. Usage model - tracks feature/service usage ...................//
model Usage {
  id          String       @id @default(uuid())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  feature         String    // Feature being tracked
  quantity        String       // Amount used
  date           DateTime  @default(now())
}

//........................ Payment method model..............................//
model Payment {
  id                String    @id @default(uuid())
  customer          Customer  @relation(fields: [customerId], references: [id])
  customerId        String
  type              PaymentType
  last4             String?      // Last 4 digits of card
  expMonth          String?      // Expiration month
  expYear           String?      // Expiration year
  isDefault         Boolean   @default(false)
  billingRecords    BillingRecord[]
  authority         String    @unique
  amount            String
  description       String    @default("بابت خرید اشتراک")
  verify            Boolean   @default(false)
  paymentDate       DateTime  @default(now())
  verifiedAt        DateTime?
  basketData        Json
  refID             String
  cardHash          String
}

//........................ BankAccount model ..............................//
model BankAccount {
  id                    String         @id @default(cuid())
  garageId             String         @unique
  garage               Garage         @relation(fields: [garageId], references: [id])
  
  bankName             String
  accountNumber        String
  routingNumber        String
  isVerified           Boolean        @default(false)
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

//............................ Invoice model ................................//
model Invoice {
  id          String       @id @default(uuid())
  customer    Customer  @relation(fields: [customerId], references: [id])
  customerId  String
  amount      Float
  status      InvoiceStatus
  dueDate     DateTime
  paidAt      DateTime?
  billingRecords    BillingRecord[]

  // Invoice items breakdown
  items       Json      // Store line items as JSON
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Enums for various statuses and types
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  TRIAL
  REWARD // New status for free reward periods
}

enum BillingStringerval {
  MONTHLY
  YEARLY
  QUARTERLY
}

enum PaymentType {
  CREDIT_CARD
  BANK_TRANSFER
  PAYPAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

//........................ Referal model ..............................//
// Referral base model - improved with additional fields
model Referral {
  id              String         @id @default(uuid())
  referrerId      String        // Who made the referral
  referrer        BusinessProfile @relation("ReferrerProfile", fields: [referrerId], references: [id])
  referredId      String        // Who was referred
  referredUser    BusinessProfile @relation("ReferredProfile", fields: [referredId], references: [id])
  status          ReferralStatus @default(PENDING)
  code            ReferralCode   @relation(fields: [codeId], references: [id])
  codeId          String
  convertedAt     DateTime?      // When the referred user became paying customer
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
}

// Referral Stats - tracks user's referral performance
model ReferralStats {
  id                  String       @id @default(cuid())
  user                BusinessProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String       @unique
  totalReferrals      Int          @default(0)
  successfulReferrals Int          @default(0)
  currentTier         ReferralTier @default(BRONZE)
  freeMonthsEarned    Int          @default(0)    // Total free subscription months earned
  freeMonthsUsed      Int          @default(0)    // How many months have been applied to subscriptions
  lastMilestoneAt     DateTime?    // When the last milestone was achieved
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId])
}

// Referral Tier Milestone - defines reward tiers
model ReferralMilestone {
  id              String    @id @default(cuid())
  tier            ReferralTier
  minReferrals    Int       // Minimum referrals needed for this tier
  rewardMonths    Int       // Free subscription months awarded
  description     String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  achievements    ReferralAchievement[]
}

// Tracks when users achieve milestones
model ReferralAchievement {
  id                    String    @id @default(cuid())
  userId                String
  user                  BusinessProfile @relation(fields: [userId], references: [id])
  milestone             ReferralMilestone @relation(fields: [milestoneId], references: [id])
  milestoneId           String
  achievedAt            DateTime  @default(now())
  rewardMonthsGranted   Int       // Number of months granted for this achievement
  rewardMonthsUsed      Int       @default(0) // How many months have been used
  
  // If reward has been applied to subscriptions
  subscriptionRewards   SubscriptionReward[]
  
  @@unique([userId, milestoneId])
  @@index([userId])
}

// Tracks how achievement rewards are applied to subscriptions
model SubscriptionReward {
  id                    String    @id @default(cuid())
  achievement           ReferralAchievement @relation(fields: [achievementId], references: [id])
  achievementId         String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId        String
  monthsApplied         Int       // How many free months were applied
  appliedAt            DateTime   @default(now())
  
  @@index([achievementId])
  @@index([subscriptionId])
}

// Referral Codes
model ReferralCode {
  id              String     @id @default(uuid())
  code            String     @unique
  userId          String
  user            BusinessProfile @relation(fields: [userId], references: [id])
  maxUses         Int?       // Optional limit on number of uses
  usedCount       Int        @default(0)
  referrals       Referral[]
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([code])
  @@index([userId])
}

enum ReferralTier {
  BRONZE    // Starting tier
  SILVER    // 3 referrals = 1 month
  GOLD      // 5 referrals = 1 month
  PLATINUM  // 7 referrals = 2 months
  DIAMOND   // 10 referrals = 2 months
}

enum ReferralStatus {
  PENDING    // Referral made but user hasn't subscribed
  COMPLETED  // Referred user became paying customer
  EXPIRED    // Referral expired before conversion
  INVALID    // Referral was invalidated
}

//........................ Reward model ..............................//
model Reward {
  id          String    @id @default(cuid())
  user        BusinessProfile      @relation(fields: [userId], references: [id])
  userId      String
  type        RewardType
  amount      Float
  status      RewardStatus @default(PENDING)
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

enum RewardType {
  CASH
  POINTS
  DISCOUNT
  PRODUCT
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
  CLAIMED
}

enum PartSupplyStatus {
  NOTADD
  INPROGRESS
  SUPPLIED
}
enum ProjectStatus {
  NOTADD
  INPROGRESS
  SUPPLIED
}

//........................ Comments model ..............................//
model Comment {
  id            String      @id @default(uuid())
  content     String      @db.Text
  
  // Tree structure relationships
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  replies     Comment[]   @relation("CommentReplies")
  
  // Depth level in the comment tree
  depth       Int         @default(0)
  path        String?     // Materialized path for faster tree traversal
  replyCount  Int         @default(0)  // Cache for reply count

  // Reference to the root post
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  
  // Author information
  author      SocialProfile        @relation("UserComments", fields: [authorId], references: [id])
  authorId    String
  
  // Vote counts (cached for performance)
  upvotes     Int         @default(0)
  downvotes   Int         @default(0)
  
  // Reactions tracking
  votes       CommentVote[]
  commentReport   CommentReport[]
  // Status flags
  isEdited    Boolean     @default(false)
  isDeleted   Boolean     @default(false)
  isPinned    Boolean     @default(false)  // New: Allow pinning important comments
  isHidden    Boolean     @default(false)  // New: Moderation purposes
  
  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  editedAt    DateTime?   // New: Track when the comment was last edited

 // Metrics 
  metricId             String
  metric               Metric          @relation(fields: [metricId], references: [id])

// Coupons 
  couponId             String
  coupon               Coupons          @relation(fields: [couponId], references: [id])

// Moderation
  reportCount Int         @default(0)  // New: Track number of reports
  moderationStatus ModStatus @default(APPROVED)  // New: Enhanced moderation
  moderatedBy  String?       // New: Moderator ID
  moderatedAt  DateTime?  // New: Moderation timestamp

  // Metadata
  metadata    Json?       // New: Flexible field for additional data

  @@index([postId])
  @@index([parentId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned, createdAt]) // New: Optimize queries for pinned comments
}

model CommentVote {
  id            String      @id @default(uuid())
  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   String
  user        SocialProfile        @relation("UserCommentsVote",fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  voteType    VoteType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt    // New: Track vote changes

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
  @@index([voteType, commentId]) // New: Optimize vote counting queries
}

model CommentReport {  // New: Report management
  id            String      @id @default(uuid())
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   String
  reporter    SocialProfile      @relation(fields: [reporterId], references: [id])
