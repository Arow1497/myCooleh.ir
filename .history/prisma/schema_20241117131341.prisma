//................... SupplyParts model .........طعات یدکی درخواست شده برای تامین توسط یدکی.............//
model SupplyParts {
  id                   String      @id @default(uuid())
  RequestedForSupplyId String      @unique
  RequestedForSupply   RequestedForSupply @relation(fields: [RequestedForSupplyId], references: [id])

// Part details
  partSpecifications   PartSpecification[]
  quantity             String
  condition            PartCondition
  brand               String?
  
  // Pricing
  unitPrice           Float
  totalPrice          Float
  
  // Availability
  inStock             Boolean           @default(true)
  estimatedDeliveryDays String?
  
  // Quality and warranty
  warrantyMonths      String?
  qualityCertification String?
  
  // Additional information
  description         String?
  manufacturingYear   String?
  
  // Timestamps
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

