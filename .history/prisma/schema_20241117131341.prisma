//........................ Transaction model ..............................//
model Transaction {
  id                   String         @id @default(cuid())
  projectId            String         @unique
  project              Project        @relation(fields: [projectId], references: [id])
  amount               Float
  status               TransactionStatus @default(PENDING)
  transactionsActivityLog  TransactionsActivityLog?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  // Completion confirmations
  requesterConfirmedCompletion  Boolean    @default(false)
  providerConfirmedCompletion   Boolean    @default(false)
  completionConfirmedAt         DateTime?
  
  // Garage PartOrder Collaboration
  garagePartOrderId    String            @unique
  garagePartOrder    GaragePartOrder  @relation(fields: [garagePartOrderId], references: [id])

// Garage OutSourcing Collaboration
  noticeOutSourcingId    String            @unique
  noticeOutSourcing    NoticeOutSourcing  @relation(fields: [noticeOutSourcingId], references: [id])

// Garage ApprenticeShip Collaboration
  noticeApprenticeId    String            @unique
  noticeApprentice    NoticeApprenticeship  @relation(fields: [noticeApprenticeId], references: [id])

// Metrics 
  metricId             String   @unique
  metric               Metric       @relation(fields: [metricId], references: [id])

// Coupons 
  couponId             String  @unique
  coupon               Coupons          @relation(fields: [couponId], references: [id])

 // Garage Dastyar Collaboration
  noticeDastyarId    String            @unique
  noticeDastyar    NoticeDastyar  @relation(fields: [noticeDastyarId], references: [id])

 // Garage OilService Project 
  garageOilServiceProjectId    String    @unique
  garageOilServiceProject     GarageOilServiceProjects      @relation(fields: [garageOilServiceProjectId], references: [id])

  // Transaction Conversation 
  conversationId       String?        @unique  // Making it unique ensures one conversation per transaction
  conversation         Conversation?  @relation("TransactionConversation", fields: [conversationId], references: [id])

  // Payment confirmations
  requesterConfirmedPayment     Boolean    @default(false)
  providerConfirmedPayment      Boolean    @default(false)
  paymentConfirmedAt            DateTime?

   // Dispute handling    ...اختلاف-نزاع...
  complaint            Complaint?   
  hasDispute           Boolean        @default(false)
  disputeReason        String?
  disputeResolution    String?

   // Payment schedule    ...بیعانه...
  depositAmount        Float?
  depositPaid          Boolean        @default(false)
  remainingAmount      Float?

  milestonePayments    MilestonePayment[]

}

//........................ Complaint model ..............................//
model Complaint {
  id                   String         @id @default(cuid())
  
  // transaction releative relation
  transactionId        String         @unique
  transaction          Transaction    @relation(fields: [transactionId], references: [id])

  // Complaint details
  authorId              String
  author                ProjectProfile           @relation("ComplaintFiler", fields: [authorId], references: [id])
  targetId              String
  target                ProjectProfile           @relation("ComplaintReceiver", fields: [targetId], references: [id])
  
  description          String
  evidence             Attachment[]    // URLs to evidence files مدرک شواهد
  response             String
  status               ComplaintStatus @default(PENDING)
  resolution           String?
  resolutionDate       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
 
  // Admin handling
  assignedAdminId      String?
  adminNotes           String?

  // Related records
  messages             Message[]
  transactionsActivityLogs         TransactionsActivityLog[]
}

//........................ Conversation model ..............................//
model Conversation {
  id                   String         @id @default(cuid())
  type                 ConversationType @default(DIRECT)
  name                 String?        // For group conversations
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastMessageAt        DateTime       @default(now())
  
  // Participants
  participants         ConversationParticipant[]
  messages             Message[]
  
  // Transaction relation - Updated
  transaction          Transaction?   @relation("TransactionConversation")
  
  // Project relation (for project-specific conversations)
  projectId            String?
  project              Project?       @relation(fields: [projectId], references: [id])
  
  // Garage OilService Project 
  garageOilServiceProjectId    String    @unique
  garageOilServiceProject     GarageOilServiceProjects      @relation(fields: [garageOilServiceProjectId], references: [id])

  // Garage PartOrder Collaboration
  garagePartOrderId    String
  garagePartOrder     GaragePartOrder      @relation(fields: [garagePartOrderId], references: [id])
  
  // Garage OutSourcing Collaboration
  noticeOutSourcingId    String            @unique
  noticeOutSourcing    NoticeOutSourcing  @relation(fields: [noticeOutSourcingId], references: [id])

// Garage ApprenticeShip Collaboration
  noticeApprenticeId    String            @unique
  noticeApprentice    NoticeApprenticeship  @relation(fields: [noticeApprenticeId], references: [id])

 // Garage Dastyar Collaboration
  noticeDastyarId    String            @unique
  noticeDastyar    NoticeDastyar  @relation(fields: [noticeDastyarId], references: [id])

 // Metrics 
  metricId             String
  metric               Metric          @relation(fields: [metricId], references: [id])

 // Coupons 
  couponId             String
  coupon               Coupons          @relation(fields: [couponId], references: [id])

  // Metadata
  isActive             Boolean        @default(true)
  metadata             Json?          // For additional flexible data storage
}

//........................ ConversationParticipant model ..............................//
model ConversationParticipant {
  id                   String         @id @default(cuid())
  conversationId       String
  conversation         Conversation   @relation(fields: [conversationId], references: [id])
  userId               String
  user                 SocialProfile           @relation(fields: [userId], references: [id])
  
  // Participant status
  role                 ParticipantRole @default(MEMBER)
  joinedAt             DateTime       @default(now())
  leftAt               DateTime?
  isActive             Boolean        @default(true)
  
  // Read status tracking
  lastReadMessageId    String?
  lastReadAt           DateTime?
  
  // Notification preferences
  isMuted              Boolean        @default(false)
  mutedUntil           DateTime?
  
  // User-specific conversation settings
  nickName             String?
  settings             Json?          // Custom settings per participant
  
  // Messages in this conversation
  messages             Message[]      // Messages sent by this participant
  
  @@unique([conversationId, userId])
}

//........................ Message model ..............................//
model Message {
  id                    String         @id @default(cuid())
  conversationId       String
  conversation         Conversation   @relation(fields: [conversationId], references: [id])
  senderId             String // فرستنده
  sender               ConversationParticipant @relation(fields: [senderId], references: [id])
  
  // Message content
  type                 MessageType    @default(TEXT)
  content              String
  attachments          Attachment[]
  metadata             Json?          // For additional message data
  
   // Message status
  status               MessageStatus  @default(SENT)
  isEdited             Boolean        @default(false)
  editedAt             DateTime?
  deletedAt            DateTime?      // Soft delete
  
  // Reply threading
  replyToId            String?
  replyTo              Message?       @relation("MessageReplies", fields: [replyToId], references: [id])
  replies              Message[]      @relation("MessageReplies")
  
  // Reactions
  reactions            MessageReaction[]

  // Read receipts
  readReceipts         MessageReadReceipt[]
  
  complaintId          String?
  complaint            Complaint?     @relation(fields: [complaintId], references: [id])
    
  createdAt            DateTime       @default(now())
}

//........................ MessageReaction model ..............................//
model MessageReaction {
  id                   String         @id @default(cuid())
  messageId            String
  message              Message        @relation(fields: [messageId], references: [id])
  userId               String
  user                 SocialProfile           @relation(fields: [userId], references: [id])
  
  emoji                String
  createdAt            DateTime       @default(now())
  
  @@unique([messageId, userId, emoji])
}

//........................ MessageReadReceipt model ..............................//
model MessageReadReceipt {
  id                   String         @id @default(cuid())
  messageId            String
  message              Message        @relation(fields: [messageId], references: [id])
  userId               String   // گیرنده
