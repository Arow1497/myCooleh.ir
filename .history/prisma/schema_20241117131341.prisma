datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}


// Core User Model - اطلاعات اصلی و ضروری کاربر
model User {
  id              String         @id @default(uuid())
  mobile          String         @db.VarChar(11)
  otp_code        Int           @default(0)
  otp_expires     Int           @default(0)
  password        Int?
  passwordResetAt  DateTime      @default(now())
  registrationDate DateTime      @default(now())
  isSystemAdmin   Boolean       @default(false)
  isActive        Boolean       @default(true)
  isSuspended     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  Courses         Course[]
  Products        Product[]
  Basket          Basket[]  
  userRole        UserRole[]

  // Business Features
  subscriptions         Subscription[]
  customer              Customer[]
  subscriptionStatus    SubscriptionStatus
  status                UserStatus @default(ACTIVE)
  notifications         Notification[]  @relation("UserNotifications")

 // Interaction Operations
  clanId                String?
  clan                  Clan?       @relation(fields: [clanId], references: [id])
  OwnedClan             Clan?       @relation("clanOwner")
  clanRole              ClanRoles   @default(MEMBER)
 
  // Related Profiles
  businessProfile            BusinessProfile?
  projectProfile             ProjectProfile?
  socialProfile              SocialProfile?
  activityProfile            ActivityProfile?
  interactiveContentProfile  InteractiveContentProfile?
  userProfile                UserProfile?
  
  @@unique([mobile])
}

model UserProfile {
  id                    String       @id @default(uuid())
  userId                String       @unique
  user                  User      @relation(fields: [userId], references: [id])
  
  // Personal Information
  first_name            String?   @db.VarChar(50)
  last_name             String?   @db.VarChar(50)
  nationalIdNumber      String?   @db.VarChar(10)
  bankAccountNumber     String?   @db.VarChar(16)
  
  // Location Information
  province              String?   @db.VarChar(20)
  city                  String?   @db.VarChar(20)
  location              String?
  garageLat_Lng         String?
  supplierStoreLat_Lng  String?
  
  // Business Metrics
  mechanicProjectsCount   String?
  apprenticeProjectsCount String?
  profit                  String?
  mechanicApprenticeCity  String?
  maxReachableReviewPoint  Int         @default(0)
  reviewPoint              Int         @default(0)
  userReferalNumber       String?
  
  // Media
  media                 UserMedia[]
  contentMedia          ContentMedia[]      @relation("UserMedia")
  profileImageUrl       String?             // Quick access to main profile image
  coverImageUrl         String?             // Quick access to cover image
  
  // Contact & Social
  website               String?
  socialLinks           Json?               // Store social media links/ zlink landingPage/story link UGC marketing

  // Timestamps
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([nationalIdNumber, bankAccountNumber])
}

// Business Profile - اطلاعات مرتبط با کسب و کار
model BusinessProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id])
  mechanicPercentage   String?
  apprenticePercentage String?
  bussinesRole         BusinessRole  @default(GARAGE_APPRENTICE)
  expertices           Expertices    @default(ENGINEGEARBOX)
  
  // Business Relations
  ownedSupplierStore  SupplierStore[]  @relation("supplierStoreOwner")
  ownedGarage         Garage[]          @relation("garageOwner")
  mechanicGarageId    String?     
  apprenticeGarageId  String?
  mechanicAt          Garage?  @relation("mechanics", fields: [mechanicGarageId], references: [id], map: "mechanics")
  apprenticeAt        Garage?  @relation("apprentices", fields: [apprenticeGarageId], references: [id], map: "apprentices")

   // Referral System
  referralCount        Int                 @default(0)
  referralAchievements ReferralAchievement[]
  referralStats        ReferralStats[]
  referralCampaign     ReferralCampaign[]  @relation("CampaignCreator")
  reward               Reward[]
  referralCodes        ReferralCode[]
  referredBy           ReferralUse[]      @relation("ReferredUser")
  profit               Int                @default(0)
  league               UserLeague

// Moderation & Reports
  reportsFiled         Report[]     @relation("ReportFiler")
  reportedBy           Report[]     @relation("ReportedUser")

}

// Project Profile - اطلاعات مرتبط با پروژه‌ها
model ProjectProfile {
  id                            String    @id @default(uuid())
  userId                        String    @unique
  user                          User      @relation(fields: [userId], references: [id])
  
  inProgressProjectMechanic     ProjectsMechanicWorkAt[]
  inProgressProjectApprentice   ProjectsApprenticeWorkAt[]
  projectProvider               Project?   @relation("providerUser")
  projectRequester              Project?   @relation("requesterUser")

  publishedmetrics              Metric[]

  // Complaints
  complaintsFiled               Complaint[]    @relation("ComplaintFiler")
  complaintsReceived            Complaint[]    @relation("ComplaintReceiver")

  // Coupons
  publishedCoupons                       Coupons[]  @relation("couponPublisher")
  acceptedCoupons                        CouponMechanicAcceptor[]
  successCoupons                         CouponMechanicSuccess[]
  Mechanic_GarageReqsForCouponAssignment Mechanic_GarageReqsForCouponAssignment?
  successfulSellCouponByGarage_Mechanic  SuccessfulSellCouponByGarage_Mechanic?

// Apprenticeship & Dastyar notices
  apprenticeNoticesPublisher         NoticeApprenticeship[] @relation("noticeApprenticePublisher")
  apprenticeNoticesApprentice        NoticeApprenticeship[] @relation("noticeApprenticeApprentice")
  garageOwnerReqsForApprentice       GarageReqsForApprenticeCoWork?      @relation("garageOwner")
  garageApprenticeBelongToGarageForApprentice GarageReqsForApprenticeCoWork?  @relation("apprentice")
  shagerdReqsForApprentice           ShagerdReqsForApprenticeCoWork?
  dastyarNoticesPublisher            NoticeDastyar[]        @relation("noticeDastyarPublisher")
  dastyarNoticesMechanic             NoticeDastyar[]        @relation("noticeDastyarMechanic")
  mechanicReadyToWork                MechanicReadyToWork?
  garageOwnerReqsForMechanic             GarageReqsForDastyarCoWork?           @relation("garageOwner")
  garageMechanicBelongToGarageForDastyar GarageReqsForDastyarCoWork?         @relation("mechanic")
  mechanicReqsForDastyar                 MechanicReqsForDastyarCoWork?
  garagePartOrder                        GaragePartOrder[] 
  sellFromSupplier                       SellFromSupplier[]
  supplierStoreReqsForMetricAssignment   SupplierStoreReqsForMetricAssignment? @relation("metricReqPublisher")
  
  
}

// Social Profile - اطلاعات اجتماعی و تعاملات
model SocialProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  socialLinks           Json?
  
  // Social Interactions
  posts                 Post[]    @relation("UserPosts")
  reposts               Repost[]                    @relation("UserReposts")
  originalPosts         Repost[]                    @relation("OriginalPoster")
  comments              Comment[] @relation("UserComments")
  likes                 Like[]    @relation("UserLikes")
  dislikes              Dislike[]  @relation("UserDislikes")
  shares                Share[]   @relation("UserShares")
  bookmarks             Bookmark[] @relation("UserBookmarks")
  reviews               Review[]       @relation("ReviewAuthor")
  receivedReviews       Review[]       @relation("ReviewTarget")
  
  // Social Features
  conversations ConversationParticipant[]
  reactions     MessageReaction[]
  readReceipts  MessageReadReceipt[]

  noticeDivar                        NoticeDivar[]  @relation("UserDivarN")
  noticeEstNiaz                      NoticeEstNiaz[]  @relation("UserEstN")
  noticePartProviding                NoticePartProviding[]  @relation("UserPartPN")
  noticeShopSupplier                 NoticeShopSupplier[]   @relation("UserShopSupplierN")
  garageReqForOutSource              GarageReqsForOutSourcingCoWork?
  garageRequirementsRequest          GarageRequirementsRequest[]          @relation("UserGarageRequirementMediaN")
  autoServicesRequirementsRequest    AutoServicesRequirementsRequest[]    @relation("UserAutoServicesRequirementMediaN")
  commentvote                        CommentVote[]               @relation("UserCommentsVote")
  commentReport                      CommentReport[]
  noticeOutSourcing                  NoticeOutSourcing[]    
}

// Activity Profile - فعالیت‌ها و لاگ‌ها
model ActivityProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  lastLoginAt     DateTime?
  lastActiveAt    DateTime?
  
  // Activity Tracking
  sessions        Session[]
  activities      UserActivity[]
  tokenRecords    TokenRecord[]
  permissionAuditLog PermissionAuditLog[]
}

// Interactive Content Profile - محتوا و نوتیفیکیشن‌ها
model InteractiveContentProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  
  // Content Items
 
}

//....... Client model - Bussineses Clients(Public-side)........//
model Client {
  id                String        @id @default(uuid())
  first_name        String?    @db.VarChar(50)
  last_name         String?    @db.VarChar(50)
  mobile            String     @unique
  otp_code          Int        @default(0)
  otp_expires       Int        @default(0)
  carPlateNumber    String?    @db.VarChar(8)
  carModel          String?
  carChassisNumber  String?
  carBuildYear      String?
  carMillage        String?
  province          String?
  city              String?
  role              BusinessRole  @default(CLIENT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // RBAC
  roles            ClientRole[]
  isPrivileged     Boolean    @default(false)  // For special client privileges
  permissionAuditLog PermissionAuditLog[]

  // Review
  reviews           Review[]
  product Product[]
  //Metrics 
  metrics           Metric[]

  wasSupplierStoreMetricAssignmentSuccessful  WasSupplierStoreMetricAssignmentSuccessful?
 
  // Project Relations
  project           Project[]

  // Project Relations
  oilServiceProject GarageOilServiceProjects[]

  // Garage Await List
  garageAwaitList   GarageAwaitList[]

  // Garage PartOrder Collaboration
  garagePartOrder   GaragePartOrder[] 

  // Basket Selling System
  Basket              Basket[] 

  @@index([first_name, last_name, mobile], name: "client_search_index")
}

//....... Clan model - represents Networking(Bussines-side) data & information........//
model Clan {
  id            String    @id @default(uuid())
  ownerId       String    @unique
  owner         User      @relation("clanOwner", fields: [ownerId], references: [id])
  users         User[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum ClanRoles {
  OWNER
  COLEADER
  MEMBER
}

// Session for activity tracking
model Session {
  id            String    @id @default(uuid())
  userId        String
  deviceInfo    String?
  ipAddress     String?
  isValid       Boolean   @default(true)
  lastActivity  DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          ActivityProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities    UserActivity[]

  @@index([userId])
  @@index([lastActivity])
  @@map("sessions")
}

// Token tracking for audit purposes
model TokenRecord {
  id            String    @id @default(uuid())
  userId        String
  tokenType     TokenType
  // Store only token identifier or hash, never the actual token
  tokenIdentifier String  @unique
  issuedBy      String?  // Service or API endpoint that issued the token
  isValid       Boolean  @default(true)
  revokedAt     DateTime?
  expiresAt     DateTime
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          ActivityProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities    UserActivity[]

  @@index([userId])
  @@index([tokenType])
  @@index([isValid])
  @@index([expiresAt])
  @@map("token_records")
}

enum TokenType {
  ACCESS
  REFRESH
}

enum UserLeague {
  GOLD
  SILVER
  BRONZE
}

// RBAC Models
model Role {
  id          String       @id @default(uuid())
  name        String    @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  clients     ClientRole[]  // New relation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Permission {
  id          String       @id @default(uuid())
  name        String    @unique
  description String?
  roles       Role[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserRole {
  id        String      @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// New model for Client roles
model ClientRole {
  id        String      @id @default(uuid())
  clientId  String
  roleId    String
  client    Client   @relation(fields: [clientId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, roleId])
}
// Audit trail for permission changes
model PermissionAuditLog {
  id            String      @id @default(uuid())
  userId        String
  user          ActivityProfile     @relation(fields: [userId], references: [id])
  clientId      String?     // Added clientId for client permission changes
  client        Client?  @relation(fields: [clientId], references: [id])
  action        String   // e.g., "GRANT_ROLE", "REVOKE_ROLE", "MODIFY_PERMISSIONS"
  resourceType  String?
  resourceId    String?
  oldValue      Json?    // Store previous state
  newValue      Json?    // Store new state
  createdAt     DateTime @default(now())
  createdBy     String      // ID of the user who made the change
  
  @@index([userId, createdAt])
}
// Resource-specific permissions enums
enum ResourcePermission {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum ResourceType {
  GARAGE
  SUPPLIER_STORE
  PROJECT
  INVENTORY
  USER
  CLIENT
  REVIEW
  COMPLAINT
  METRIC
  COUPON
  NOTIFICATION
  SUBSCRIPTION
  SERVICE_REQUEST    // For client service requests
  APPOINTMENT        // For client appointments
  PAYMENT           // For client payments
  HISTORY           // For viewing service history
}

// User Profile Media
model UserMedia {
  id              String    @id @default(cuid())
  userId          String
  user            UserProfile      @relation(fields: [userId], references: [id])
  url             String
  type            UserMediaType
  metadata        Json?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([type])
}

enum UserMediaType {
  AVATAR
  COVER_IMAGE
  GALLERY_IMAGE
  DOCUMENT
  CERTIFICATE
}

enum BusinessRole {
  GARAGE_OWNER         // صاحب گاراژ
  GARAGE_MECHANIC     // مکانیک گاراژ
  GARAGE_APPRENTICE   // شاگرد گاراژ
  FREELANCER_MECHANIC // مکانیک آزاد
  FREELANCER_APPRENTICE // شاگرد آزاد
  SUPPLIER_STORE_OWNER // صاحب فروشگاه لوازم
  FREELANCER_SUPPLIER  // تامین کننده آزاد
  CLIENT              // مشتری
  ADMIN               // ادمین سیستم
}

enum BusinessType {
  MECHANICI      // گاراژ تعمیر موتور
  BODY_REPAIR_SAFKARI       // گاراژ تعمیر بدنه
  AUTOSERVICE_OIL_CHANGE       // اتوسرویس تعویض روغن
  PARTS_SUPPLIER   // تامین کننده لوازم یدکی
  FREELANCER_MECHANIC // مکانیک آزاد
  FREELANCER_SUPPLIER // تامین کننده آزاد
  PDRDENT // پی دی آر
}

enum UserStatus {
  ACTIVE //آماده بکار
  MORKHASI // مرخصی
}
enum Expertices {
JOLOBANDI //   جلوبندی ساز
ELECTRITIAN //   باطری ساز و برقی خودرو
ENGINEGEARBOX //   موتور گیربکس
OILAUTOSERVICE //   سرویسکار
BODYREPAIR //   صافکار نقاش و بدنه
PDRDENT // پی دی آر
}

// Garage Media
model GarageMedia {
  id          String    @id @default(cuid())
  garageId    String
  garage      Garage    @relation(fields: [garageId], references: [id])
  url         String
  type        GarageMediaType
  metadata    Json?
  isArchived  Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([garageId])
  @@index([type])
}

enum GarageMediaType {
  PROFILE_IMAGE     // Main garage profile image
  COVER_IMAGE       // Background/banner image
  SHOP_EXTERIOR     // Outside views
  SHOP_INTERIOR     // Inside views
  WORK_AREA         // Workspace/equipment photos
  CERTIFICATE       // Business certificates/permits
  STAFF             // Team/staff photos
  COMPLETED_WORK    // Portfolio of completed repairs
  EQUIPMENT         // Tools and machinery
}

// Supplier Store Media
model SupplierStoreMedia {
  id                String    @id @default(cuid())
  supplierStoreId   String
  supplierStore     SupplierStore @relation(fields: [supplierStoreId], references: [id])
  url               String
  type              SupplierMediaType
  metadata          Json?
  isArchived        Boolean   @default(false)
  isFeatured        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([supplierStoreId])
  @@index([type])
}

enum SupplierMediaType {
  PROFILE_IMAGE     // Main store profile image
  COVER_IMAGE       // Background/banner image
  STORE_EXTERIOR    // Outside views
  STORE_INTERIOR    // Inside views
  PRODUCT_CATALOG   // Product images
  WAREHOUSE         // Warehouse/inventory photos
  CERTIFICATE       // Business certificates/permits
  STAFF             // Team photos
}

// Content Media (for posts, comments, etc.)
model ContentMedia {
  id                        String    @id @default(cuid())
  url                       String
  type                      ContentMediaType
  postId                    String
  post                      Post      @relation("PostMedia", fields: [postId], references: [id], onDelete: Cascade)
  productId                 String
  product                   Product   @relation("ProductMedia", fields: [productId], references: [id], onDelete: Cascade)
  noticeDivarId             String
  noticeDivar               NoticeDivar        @relation("DivarNMedia", fields: [noticeDivarId], references: [id], onDelete: Cascade)
  noticeEstId               String
  noticeEst                 NoticeEstNiaz        @relation("EstNMedia", fields: [noticeEstId], references: [id], onDelete: Cascade)  
  noticePartPId             String
  noticePartP               NoticePartProviding        @relation("PartPNMedia", fields: [noticePartPId], references: [id], onDelete: Cascade)  
  noticeShopSupplierId      String
  noticeShopSupplier        NoticeShopSupplier        @relation("ShopSupplierNMedia", fields: [noticeShopSupplierId], references: [id], onDelete: Cascade)  
  garageRequirementsRequestId        String
  garageRequirementsRequest          GarageRequirementsRequest        @relation("GarageRequirementMedia", fields: [garageRequirementsRequestId], references: [id], onDelete: Cascade)  
  autoServicesRequirementsRequestId  String
  autoServicesRequirementsRequest    AutoServicesRequirementsRequest        @relation("AutoServicesRequirementMedia", fields: [autoServicesRequirementsRequestId], references: [id], onDelete: Cascade)  

  userId    String
  user      UserProfile      @relation("UserMedia", fields: [userId], references: [id], onDelete: Cascade)
  caption   String?
  altText   String?
  order     Int       @default(0)
  metadata  Json?
  filename             String
  fileSize             String
  mimeType             String

  // Metadata
  duration             String?           // For audio/video files
  dimensions           Json?          // For images
  thumbnailUrl         String?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([userId])
}

enum ContentMediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  GIF
  EMBEDDED
}

//....... Report model - forum posts Bussines-side........//
model Report {
  id               String       @id @default(uuid())
  reporter          BusinessProfile      @relation("ReportFiler", fields: [reporterId], references: [id])
  reporterId        String
  reportedUser      BusinessProfile      @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedUserId    String
  reason            ReportReason
  description       String    @db.Text
  status            ReportStatus @default(PENDING)
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  resolution        String?   @db.Text

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}
enum ReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE_CONTENT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ..........................UserActivity tracking model ..................................//
model UserActivity {
  id            String    @id @default(cuid())
  user          ActivityProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          ActivityType
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenRecordId String?   // Optional link to the token used
  tokenRecord   TokenRecord? @relation(fields: [tokenRecordId], references: [id])
  entityType    String    
  entityId      String 
  metadata      Json?     // Additional activity data
  ipAddress     String?
  userAgent     String?
  statusCode    String?     
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum ActivityType {
  POST_CREATE
  POST_UPDATE
  POST_DELETE
  COMMENT_CREATE
  COMMENT_UPDATE
  COMMENT_DELETE
  METRIC
  COUPON
  DASTYARREQ
  FAILED_LOGIN
  PERMISSION_DENIED
  TOKEN_REFRESH
  TOKEN_REVOKED
  TOKEN_CREATED
  FOLLOW
  UNFOLLOW
  VOTE
  BOOKMARK
  SHARE
  PROFILE_UPDATE
  LOGIN
  LOGOUT
}

//................... Post model - forum posts Bussines-side......................//
model Post {
  id          String       @id @default(uuid())
  title       String
  description String
  content     String    @db.Text
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  postField   PostFields
  postType    PostType

 // Media - Changed to one-to-many relation
  featuredImage   String?
  contentMedia    ContentMedia[]      @relation("PostMedia")

 // repost related
  isRepost            Boolean     @default(false)
  originalPostId      String?     // آیدی پست اصلی در صورت ریپست بودن
  originalPost        Post?       @relation("Reposts", fields: [originalPostId], references: [id])
  reposts             Post[]      @relation("Reposts")
  repostCount         Int         @default(0)

  postReposts         Repost[]    @relation("PostReposts")

  // Author
  authorId    String
  author      SocialProfile      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  // Categories and tags
  categories  CategoryOnPost[]
  tags        TagOnPost[]

  // Stringeractions
  comments    Comment[] 
  likes       Like[]     @relation("PostLikes")
  dislikes    Dislike[]  @relation("PostDislikes")
  bookmarks   Bookmark[] @relation("PostBookmarks")
  shares      Share[]    @relation("PostShares")

  // Meta
  viewCount   Int       @default(0)
  shareCount  Int       @default(0)
  slug        String    @unique
  metadata    Json?     // For SEO and other metadata

  @@index([authorId])
  @@index([slug])
  @@index([createdAt])
}

//................... Repost model - forum reposts Bussines-side......................//
model Repost {
  id                String    @id @default(uuid())
  
  // رابطه با کاربری که ریپست کرده
  userId            String
  user              SocialProfile      @relation("UserReposts", fields: [userId], references: [id])
  
  // رابطه با پست اصلی
  postId            String
  post              Post      @relation("PostReposts", fields: [postId], references: [id])
  
  // رابطه با کاربر اصلی پست
  originalPosterId  String
  originalPoster    SocialProfile      @relation("OriginalPoster", fields: [originalPosterId], references: [id])
  
  // متن اضافی که کاربر موقع ریپست می‌تواند اضافه کند
  additionalContent String?   @db.Text
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
