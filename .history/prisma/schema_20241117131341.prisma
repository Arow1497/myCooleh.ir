  successfulSellCouponByGarage_Mechanic    SuccessfulSellCouponByGarage_Mechanic  @relation(fields: [successfulSellCouponByGarage_MechanicId], references: [id])

// WasSupplierStoreMetricAssignmentSuccessful 
  wasSupplierStoreMetricAssignmentSuccessfulId             String
  wasSupplierStoreMetricAssignmentSuccessful   WasSupplierStoreMetricAssignmentSuccessful  @relation(fields: [wasSupplierStoreMetricAssignmentSuccessfulId], references: [id])

}

