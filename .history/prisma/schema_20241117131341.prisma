  providerId           String      @unique
  provider             ProjectProfile        @relation("providerUser", fields: [providerId], references: [id])   
  clientId             String      @unique
  client               Client      @relation(fields: [clientId], references: [id])
  garageId             String      @unique
  garage               Garage      @relation(fields: [garageId], references: [id])
  suplierStoreId       String      @unique
  acceptedSuppleirStore SupplierStore   @relation(fields: [suplierStoreId], references: [id])
  partSupplyStatus     PartSupplyStatus   @default(NOTADD)
  mechanicsTeam        ProjectsMechanicWorkAt[]             
  apprenticesTeam      ProjectsApprenticeWorkAt[]           
  invoiceFactorUrl     String?
  title                String
  car                  String
  plateNumber          String   
  chassisNumber        String
  carMillage           String    
  buildYear            String    
  brokeReportDetails   String        
  fixReportDetails     String      
  clientRate           String  
  suppliedParts        String     
  invoiceFactor        String   
  partSupplyFactor     String
  description          String
  status               CollaborationStatus  @default(PENDING)
  budget               Float
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?
  priority             Priority       @default(NORMAL)
  deadline             DateTime?
  requirements         Json?          // Detailed project requirements
  attachments          Attachment[]      // Array of attachment URLs
   
