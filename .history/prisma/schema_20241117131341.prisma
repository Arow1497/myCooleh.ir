  // Metadata
  metadata        Json?     // Flexible field for additional data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Enhanced Subscription Tracking
model SubscriptionTier {
  id              String           @id @default(uuid())
  name            String
  description     String?
  features        Json          // Detailed feature set
  referralRequirements Json     // Requirements for referral-based upgrades
  plans           Plan[]        // Different payment plans for this tier
