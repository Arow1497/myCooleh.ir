datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Course {
  id       Int       @id @default(autoincrement())
  courseId Int
  count    Int       @default(1)
  basketId Int?
  Basket   Basket?   @relation(fields: [basketId], references: [id])
}

model Product {
  id        Int      @id @default(autoincrement())
  productId Int
  count     Int      @default(1)
  basketId  Int?
  Basket    Basket?  @relation(fields: [basketId], references: [id])
}

model Basket {
  id       Int       @id @default(autoincrement())
  courses  Course[]
  products Product[]
}

model User {
  id                Int       @id @default(autoincrement())
  first_name        String?
  last_name         String?
  mobile            String     @unique
  otp_code          Int        @default(0)
  otp_expires       Int        @default(0)
  registrationDate  DateTime   @default(now())
  profilePicture    String?
  profit            String?
  userReferalNumber String?
  supplierStoreId  Int?
  supplierStore     SupplierStore   @relation(fields: [supplierStoreID], refrence: [id])
  garageId          Int?
  garage            Garage     @relation(fields: [garageID], refrence: [id])
  expertices        Expertices
  bankAccountNumber String?
  garageLat_Lng     String?
  supplierStoreLat_Lng String?
  readyToWork       Boolean    @default(false)
  otherBussinesesBookmarks Int[]?
  inWorkGarage      Int[]?
  resumeGarage      Int[]?
  role              Role
  bookmarks         Int[]?
  Courses           Course[]?
  Products          Product[]?
  basketId          Int?
  Basket            Basket?    @relation(fields: [basketId], references: [id])
  referals          User[]?    @relation("UserReferals")
}

enum Role {
  مکانیک
  شاگرد
  صاحب گاراژ
  مشتری
  تامین کننده
}
enum Expertices {
  جلوبندی ساز
  باطری ساز و برقی خودرو
  موتور گیربکس
  سرویسکار
  صافکار نقاش و بدنه
}

model Post {
 id                Int        @id @default(autoincrement())
 createdAt         DateTime   @default(now())
 updatedAt         DateTime   @updatedAt
 publisherId       Int
 publisher         User       @relation(fields: [publisherId], references: [id])
 title             String
 description       String
 images            String[]
 time              String?
 videoAdress       String?
 price             Float
 views             Int
 tags              String[]
 field             PostFields
 type              PostType
 category          Category
 comments          Comment[]
 likes             Like[]
 dislikes          Dislike[]
 bookmarks         Bookmark[]     
 showOnField       Boolean    @default(true)
 shareLink         String
}

model Like {

}

model Dislike {
  
}

model Bookmark {
  
}

enum PostFields {
mechanics
autoServices
bodyShops
suppliers
 }

enum PostType {
experts 
public
}

model Client {
  id                Int        @id @default(autoincrement())
  first_name        String?
  last_name         String?
  mobile            String     @unique
  otp_code          Int        @default(0)
  otp_expires       Int        @default(0)
  carPlateNumber    String?
  carModel          String?
  carChassisNumber  String?
  carBuildYear      String?
  province          String?
  city              String?
  role              String
  basketId          Int?
  Basket            Basket?    @relation(fields: [basketId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([first_name, last_name, mobile], name: "client_search_index")
}

model Garage {
  id                   Int      @id @default(autoincrement())
  ownerId              Int
  owner                User     @relation(fields: [ownerId], references: [id])
  garage_name          String
  garageSerialNumber   String?
  sign                 String?
  telephone            String?
  address              String?
  lat_lng              String?
  profit               String?
  garageMainField      GarageMainField?
  garageField          GarageField?
  mechanicsTeam        User[]?
  shagerds             User[]?
  images               String[]?
  partOrderSuppliers   SupplierStore[]? /// ایدی یدکی هایی که تابحال تامین قطعه درصدی کردن برای تععین رسیدن به 5 همکاری
  referals             Garage[] @relation("GarageReferals")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([garage_name, telephone], name: "garage_search_index")
}

enum GarageMainField {
  مکانیکی
  سرویس روغن
صافکاری و نقاشی  
}
enum GarageField {
  جلوبندی سازی
  باطری سازی و برقی خودرو
  موتور گیربکس
  سرویسکار
  صافکاری نقاشی و بدنه
}

model SupplierStore {
  id               Int      @id @default(autoincrement())
  name             String?
  ownerId          Int
  owner            User     @relation(fields: [ownerId], references: [id])
  telephone        String?
  address          String?
  serialNumber     String?
  profit           String?
  field            String
  images           String[]
  partOrderGarages PartOrderGarage[]
  referrals        Referral[]
}

model PartOrderGarage {
  id              Int      @id @default(autoincrement())
  supplierStoreId Int
  // other fields...

  supplierStore   SupplierStore @relation(fields: [supplierStoreId], references: [id])
}

model Referral {
  id              Int      @id @default(autoincrement())
  supplierStoreId Int
  // other fields...

  supplierStore   SupplierStore @relation(fields: [supplierStoreId], references: [id])
}