// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// This is created by bolt AI
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(uuid())
  count     Int      @default(1)
  baskets   Basket[] @relation("BasketToProduct")
}

model Course {
  id        String   @id @default(uuid())
  count     Int      @default(1)
  baskets   Basket[] @relation("BasketToCourse")
}

model Basket {
  id        String    @id @default(uuid())
  courses   Course[]  @relation("BasketToCourse")
  products  Product[] @relation("BasketToProduct")
  client    Client?   @relation(fields: [clientId], references: [id])
  clientId  String? @unique
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
}

model Client {
  id               String   @id @default(uuid())
  first_name       String?
  last_name        String?
  mobile           String
  otp              Json?
  carPlateNumber   String?
  carModel         Json?
  carChassisNumber Json?
  carBuildYear     Json?
  province         String?
  city             String?
  Role             String
  basket           Basket?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Garage {
  id                   String          @id @default(uuid())
  garageOwner          User            @relation("GarageOwner", fields: [garageOwnerId], references: [id])
  garageOwnerId        String
  garage_name          String
  garageSerialNumber   String?
  sign                 String?
  telephone            String?
  addres               String?
  images               Image[]
  lat_lng              String?
  profit               String?
  garageMainField      String
  garageField          String?
  mechanicsTeam        User[]          @relation("MechanicsTeam")
  shagerds             User[]          @relation("Shagerds")
  partOrderGarages     SupplierStore[] @relation("PartOrderGarages")
  referals             Garage[]        @relation("GarageReferals")
  referredBy           Garage?         @relation("GarageReferals", fields: [referredById], references: [id])
  referredById         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model User {
  id                     String          @id @default(uuid())
  first_name             String?
  last_name              String?
  mobile                 String          @unique
  otp                    Json?
  registrationDate       DateTime        @default(now())
  profilePicture         String?
  profit                 String?
  userReferalNumber      String?
  expertices             String?
  supplierStores         SupplierStore[]
  garage                 Garage?         @relation("GarageOwner")
  bankAccountNumber      String?
  garageLat_Lng          Json?
  supplierStoreLat_Lng   Json?
  readyToWork            Boolean         @default(false)
  otherBussinesesBookmarks User[]        @relation("Bookmarks")
  inWorkGarage           Garage[]        @relation("MechanicsTeam")
  resumeGarage           Garage[]        @relation("Shagerds")
  bookmarkedBy           User[]          @relation("Bookmarks")
  Role                   String          @default("shagerd")
  courses                Course[]
  products               Product[]
  basket                 Basket?
  likes                  Metric[]   @relation("MetricLikes")
  dislikes               Metric[]   @relation("MetricDislikes")
  referals               User[]          @relation("Referals")
  referredBy             User?           @relation("Referals", fields: [referredById], references: [id])
  referredById           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model SupplierStore {
  id                        String          @id @default(uuid())
  supplierstore_name        String?
  supplierstoreOwner        User            @relation(fields: [supplierstoreOwnerId], references: [id])
  supplierstoreOwnerId      String
  telephone                 String?
  addres                    String?
  supplierStoreSerialNumber String?
  profit                    String?
  supplierstoreField        String
  images                    Image[]
  partOrderGarages          Garage[]        @relation("PartOrderGarages")
  referals                  SupplierStore[] @relation("SupplierStoreReferals")
  referredBy                SupplierStore?  @relation("SupplierStoreReferals", fields: [referredById], references: [id])
  referredById              String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Conversation {
  id           String    @id @default(uuid())
  participants User[]
  messages     Message[]
}

model Message {
  id           String       @id @default(uuid())
  sender       User         @relation(fields: [senderId], references: [id])
  senderId     String
  text         String?
  fileURL      String?
  fileType     String?
  readBy       User?        @relation("ReadMessages", fields: [readById], references: [id])
  readById     String?
  deleteBy     User?        @relation("DeletedMessages", fields: [deleteById], references: [id])
  deleteById   String?
  deleted      Boolean      @default(false)
  location     Json?
  conversation Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  invoiceNumber String?
  authority     String?
  paymentDate   Int?
  amount        Int?
  description   String?  @default("بابت خرید اشتراک")
  verify        Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  basket        Json?
  refID         String?
  cardHash      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id                 String                 @id @default(uuid())
  user               User                   @relation(fields: [userId], references: [id])
  userId             String
  //currentSubscription SubscriptionHistory?
  subscriptionHistory SubscriptionHistory[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model SubscriptionHistory {
  id               String       @id @default(uuid())
  user             User         @relation(fields: [userId], references: [id])
  userId           String
  subscriptionType String       @default("free")
  purchaseDate     DateTime     @default(now())
  startDate        DateTime
  endDate          DateTime
  amountPaid       Int
  isActive         Boolean      @default(true)
  payment          Payment      @relation(fields: [paymentId], references: [id])
  paymentId        String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId   String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Transaction {
  id                     String   @id @default(uuid())
  transactionAsker       User     @relation("TransactionAsker", fields: [transactionAskerId], references: [id])
  transactionAskerId     String
  transactionAnswerer    User     @relation("TransactionAnswerer", fields: [transactionAnswererId], references: [id])
  transactionAnswererId  String
  transactionSerialNumber String
  outSourcingReq         AgahiBoronsepari? @relation(fields: [outSourcingReqId], references: [id])
  outSourcingReqId       String?
  dastyarReq             DastyarRequest? @relation(fields: [dastyarReqId], references: [id])
  dastyarReqId           String?
  apprenticeRequest      ApprenticeRequest? @relation(fields: [apprenticeRequestId], references: [id])
  apprenticeRequestId    String?
  partOrderRequest       GaragePartsOrder? @relation(fields: [partOrderRequestId], references: [id])
  partOrderRequestId     String?
  coupon                 Coupon? @relation(fields: [couponId], references: [id])
  couponId               String?
  metric                 Metric? @relation(fields: [metricId], references: [id])
  metricId               String?
  askerBankAccountNum    String
  answererBankAccountNum String
  //askerVarizSmsData      SmsData[]
  answererBardashtSmsData SmsData[]
  isTransactionDoneAsker Boolean @default(false)
  isTransactionDoneAnswerer Boolean @default(false)
  cheatReportAsker       Boolean @default(false)
  cheatReportAnswerer    Boolean @default(false)
  isTransactionClosed    Boolean @default(false)
  transactionMessages    Conversation? @relation(fields: [transactionMessagesId], references: [id])
  transactionMessagesId  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SmsData {
  id                 String      @id @default(uuid())
  time               String
  date               String
  miniBankAccountNum String
  amount             String
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  transactionId      String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

