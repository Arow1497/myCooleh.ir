}

model Comment {
  id        String   @id @default(uuid())
  fromUser  User?    @relation("CommentFromUser", fields: [fromUserId], references: [id])
  fromUserId String?
  fromClient Client? @relation("CommentFromClient", fields: [fromClientId], references: [id])
  fromClientId String?
  toGarage  Garage?  @relation("CommentToGarage", fields: [toGarageId], references: [id])
  toGarageId String?
  toMechanic User?   @relation("CommentToMechanic", fields: [toMechanicId], references: [id])
  toMechanicId String?
  toSupplierStore SupplierStore? @relation("CommentToSupplierStore", fields: [toSupplierStoreId], references: [id])
  toSupplierStoreId String?
  comment   String
  show      Boolean  @default(true)
  openToComment Boolean @default(true)
  answers   Answer[]
  createdAt DateTime @default(now())
}

model Answer {
  id         String   @id @default(uuid())
  fromUser   User?    @relation("AnswerFromUser", fields: [fromUserId], references: [id])
  fromUserId String?
  fromClient Client?  @relation("AnswerFromClient", fields: [fromClientId], references: [id])
